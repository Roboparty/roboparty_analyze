+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <pthread.h>
+#include <sched.h>
+#include <stdexcept>
+#include <sys/syscall.h>
+#include <time.h>
+#include <thread>
+#include <unistd.h>
+
+// Opt-in diagnostics. Each producer owns a ring; only the dump worker does I/O.
+namespace motor_response_trace {
+inline uint64_t now_ns() {
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return uint64_t(ts.tv_sec) * 1000000000ULL + ts.tv_nsec;
+}
+enum Kind { Increment = 1, Clear, Check, SocketRead, TxQueue, SocketWrite, Fault };
+struct Event {
+    uint64_t start_ns, end_ns, object, payload;
+    int tid, cpu, kind, iface, id, before, after, detail;
+};
+class Recorder {
+    static constexpr unsigned Slots = 32, Capacity = 32768;
+    struct Ring {
+        std::atomic<bool> writing{false};
+        uint64_t count = 0;
+        std::array<Event, Capacity> events{};
+    };
+    std::unique_ptr<Ring[]> rings_;
+    std::atomic<unsigned> claimed_{0};
+    std::atomic<uint64_t> dropped_{0};
+    std::atomic<bool> frozen_{false}, stop_{false}, dumped_{false};
+    std::thread worker_;
+    FILE* file_ = nullptr;
+
+    void dump() {
+        if (dumped_.exchange(true)) return;
+        for (unsigned i = 0; i < Slots; ++i) {
+            while (rings_[i].writing.load()) std::this_thread::yield();
+        }
+        fprintf(file_, "# clock=CLOCK_MONOTONIC pid=%d dropped=%llu slots=%u capacity=%u\n",
+                getpid(), (unsigned long long)dropped_.load(), Slots, Capacity);
+        fprintf(file_, "start_ns,end_ns,object,payload,tid,cpu,kind,ifindex,id,before,after,detail\n");
+        for (unsigned i = 0; i < Slots; ++i) {
+            const auto& ring = rings_[i];
+            const auto first = ring.count > Capacity ? ring.count - Capacity : 0;
+            fprintf(file_, "# slot=%u total=%llu overwritten=%llu\n", i,
+                    (unsigned long long)ring.count, (unsigned long long)first);
+            for (auto n = first; n < ring.count; ++n) {
+                const auto& e = ring.events[n % Capacity];
+                fprintf(file_, "%llu,%llu,%llu,%llu,%d,%d,%d,%d,%d,%d,%d,%d\n",
+                        (unsigned long long)e.start_ns, (unsigned long long)e.end_ns,
+                        (unsigned long long)e.object, (unsigned long long)e.payload,
+                        e.tid, e.cpu, e.kind, e.iface, e.id, e.before, e.after, e.detail);
+            }
+        }
+        fprintf(file_, "# dump_complete=1\n");
+        fflush(file_);
+    }
+public:
+    const bool enabled;
+    Recorder() : enabled([] { const char* p = getenv("MOTOR_RESPONSE_TRACE"); return p && !strcmp(p, "1"); }()) {
+        if (!enabled) return;
+        const char* dir = getenv("MOTOR_RESPONSE_TRACE_DIR");
+        if (!dir || !*dir) throw std::runtime_error("Set MOTOR_RESPONSE_TRACE_DIR to an existing writable directory");
+        char path[4096];
+        const int size = snprintf(path, sizeof(path), "%s/motor-response-%d-%llu.csv", dir,
+                                  getpid(), (unsigned long long)now_ns());
+        if (size < 0 || size >= int(sizeof(path))) throw std::runtime_error("Trace path too long");
+        file_ = fopen(path, "wx");
+        if (!file_) throw std::runtime_error("Cannot create motor response trace");
+        rings_.reset(new Ring[Slots]); // Allocate and touch storage before CAN threads start.
+        worker_ = std::thread([this] {
+            pthread_setname_np(pthread_self(), "motortrace_dump");
+            sched_param param{};
+            pthread_setschedparam(pthread_self(), SCHED_OTHER, &param);
+            while (!stop_.load() && !frozen_.load())
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            if (frozen_.load()) dump();
+        });
+    }
+    ~Recorder() {
+        if (!enabled) return;
+        frozen_.store(true);
+        stop_.store(true);
+        if (worker_.joinable()) worker_.join();
+        dump();
+        fclose(file_);
+    }
+    void emit(int kind, const void* object, int iface, int id, int before, int after,
+              int detail = 0, uint64_t payload = 0, uint64_t start = 0, uint64_t end = 0) {
+        if (!enabled || frozen_.load()) return;
+        thread_local const unsigned slot = claimed_.fetch_add(1);
+        thread_local const int thread_id = int(syscall(SYS_gettid));
+        if (slot >= Slots) { dropped_.fetch_add(1); return; }
+        auto& ring = rings_[slot];
+        // Sequentially consistent handshake: the reader freezes all writers first.
+        ring.writing.store(true);
+        if (!frozen_.load()) {
+            const auto stamp = end ? end : now_ns();
+            ring.events[ring.count % Capacity] = {start ? start : stamp, stamp,
+                uint64_t(reinterpret_cast<uintptr_t>(object)), payload,
+                thread_id, sched_getcpu(), kind, iface, id, before, after, detail};
+            ++ring.count;
+        }
+        ring.writing.store(false);
+    }
+    void freeze() { if (enabled) frozen_.store(true); }
+};
+inline Recorder& recorder() { static Recorder value; return value; }
+
+// Preserve atomic operation ordering, including the value replaced by RX clear.
+class Counter {
+    std::atomic<int> value_{0};
+    const void* owner_ = nullptr;
+    int iface_ = 0, id_ = 0;
+public:
+    explicit Counter(int value = 0) : value_(value) {}
+    void identify(const void* owner, int iface, int id) { owner_ = owner; iface_ = iface; id_ = id; }
+    int operator++(int) {
+        auto& r = recorder();
+        const auto begin = r.enabled ? now_ns() : 0;
+        const int old = value_.fetch_add(1);
+        if (r.enabled) r.emit(Increment, owner_, iface_, id_, old, old + 1, 0, 0, begin, now_ns());
+        return old;
+    }
+    Counter& operator=(int value) {
+        auto& r = recorder();
+        const auto begin = r.enabled ? now_ns() : 0;
+        const int old = value_.exchange(value);
+        if (r.enabled) r.emit(Clear, owner_, iface_, id_, old, value, 0, 0, begin, now_ns());
+        return *this;
+    }
+    operator int() const {
+        auto& r = recorder();
+        const auto begin = r.enabled ? now_ns() : 0;
+        const int value = value_.load();
+        if (r.enabled) r.emit(Check, owner_, iface_, id_, value, value, 0, 0, begin, now_ns());
+        return value;
+    }
+};
+}
