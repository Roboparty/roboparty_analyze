# USBMON_IFACE may be "auto" or an explicit interface such as usbmon3.
USBMON_IFACE=auto
CAN_INTERFACE=can3
CAPTURE_DIR=/run/usbcan
FILE_SIZE_MB=64
FILE_COUNT=8

# Session directory root; must be on persistent storage large enough for
# a full capture (the old /var/log/robopi default is a 47MB zram tmpfs).
SESSION_ROOT=/home/robo/robopi-logs

# Session cleanup, run before each new capture starts and every 20 seconds: sessions older than
# SESSION_RETENTION_DAYS are removed; beyond that, sessions are removed
# newest-first-protected/oldest-first-evicted once their combined size
# would exceed SESSION_MAX_TOTAL_MB. Sizing the second rule directly in
# disk space (not a session count) keeps it correct regardless of how
# fast sessions are produced, e.g. once SESSION_MAX_DURATION_SECS rotation
# is in play.
SESSION_RETENTION_DAYS=7
SESSION_MAX_TOTAL_MB=6000

# Rotate oversized active sessions via SIGUSR1 to the capture orchestrator.
# This is a soft bound: allow for one check interval and teardown conversion.
# The active session is never deleted; completed sessions are evicted first.
SESSION_MAX_SIZE_MB=1024

# Auto-rotate a running capture into a fresh session after this many
# seconds, so no single session's files can grow unbounded during a long
# unattended run. 0 disables rotation (a single session runs until
# stopped, the pre-rotation behavior).
SESSION_MAX_DURATION_SECS=1800

# Max seconds to wait for CAN_INTERFACE before giving up on the ring capture.
USBCAN_CAN_WAIT_SECS=120

# Seven-dimensional capture writes PCAP segments directly into each session.
# FILE_COUNT bounds the standalone /run ring only; session size and retention
# are controlled by the guard above. ASC conversion is explicitly offline.

