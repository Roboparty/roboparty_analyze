[Unit]
Description=CPU0 bounded scheduling and IRQ flight recorder
After=systemd-udev-trigger.service

[Service]
Type=simple
EnvironmentFile=-/etc/roboos/env
ExecStart=/bin/bash -lc 'exec /usr/bin/python3 "$${ROBOOS_PREFIX:-/opt/roboparty}/lib/roboparty-analyze/ebpf/cpu0-flight.py" run'
Nice=10
RuntimeDirectory=roboparty-cpu0-trace
KillSignal=SIGINT
TimeoutStopSec=90
Restart=no

[Install]
WantedBy=multi-user.target
