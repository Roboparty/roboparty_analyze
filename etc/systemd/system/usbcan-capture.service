[Unit]
Description=RoboPi seven-dimensional communication recorder
Documentation=file:/usr/share/doc/roboparty-analyze/README.md
After=local-fs.target systemd-modules-load.service hpm-log-capture.service
Wants=hpm-log-capture.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/default/usbcan-capture
RuntimeDirectory=usbcan
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/opt/roboparty/bin/robopi-seven-capture
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
# Allow recorders to flush their final buffers and finalize the manifest.
TimeoutStopSec=300
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=batch
CPUAffinity=2 3
UMask=0027

[Install]
WantedBy=multi-user.target
