[Unit]
Description=RoboPi HPM UART log capture
Documentation=file:/usr/share/doc/roboparty-analyze/README.md

[Service]
Type=simple
EnvironmentFile=/etc/default/hpm-log-capture
ExecStart=/opt/roboparty/bin/hpm-log-capture
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hpm-uart
CPUAffinity=2 3

[Install]
WantedBy=multi-user.target
